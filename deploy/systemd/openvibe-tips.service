[Unit]
Description=OpenVibe.Tips — creator support: tips, goals, paid messages, TTS and media requests, overlays
# Network signs the tokens Tips verifies (its key is fetched at boot and retried); Billing moves
# the money; Events carries Billing's settlements in and Tips' events out. Tips starts without any
# of them: pages and overlays keep working, payments wait.
# Its own data (ADR-035, OpenVibe.Host's data role): PostgreSQL (migrations at boot on the direct
# connection, then PgBouncer) is required, the process exits and is restarted until it answers;
# Valkey is shared state only (without it everything shared is counted per process).
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=openvibe-network.service openvibe-billing.service postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.tips
EnvironmentFile=/etc/openvibe/tips.env
Environment=NODE_ENV=production
Environment=PORT=4610
Environment=HOST=127.0.0.1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.tips/server/index.js
Restart=always
RestartSec=5
# DATABASE_URL, DATABASE_DIRECT_URL, VALKEY_URL and VALKEY_PREFIX come from the env file
# (roles/data/add-service.sh tips).
StateDirectory=openvibe-tips
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
