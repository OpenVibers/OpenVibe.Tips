# ═══════════════════════════════════════════════════════════════
# openvibe.tips — Environment Configuration
# Copy to .env for development. In production this lives at /etc/openvibe/tips.env (0600).
# Names only here; never commit a value.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4610
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4610
TRUST_PROXY=1

# SQLite (one database per service). The systemd unit sets /var/lib/openvibe-tips/tips.db.
TIPS_DB_PATH=./data/tips.db

# ── Identity: OpenVibe.Network ──────────────────────────────
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
#OV_NETWORK_ISSUER=https://openvibe.network
# Optional: pin the Network's RS256 public key (PEM, \n escaped) instead of fetching the JWKS.
#OV_NETWORK_PUBLIC_KEY=
# Audience Tips accepts on incoming service tokens.
TIPS_AUDIENCE=openvibe.tips
# Tips' client in the Network (client `tips`): browser sign-in (redirect ${BASE_URL}/auth/callback)
# and client-credentials tokens for Billing, Events, Live and Network.
OV_OAUTH_CLIENT_ID=tips
OV_OAUTH_CLIENT_SECRET=
#OV_OAUTH_REDIRECT_URI=https://openvibe.tips/auth/callback
#COOKIE_SECURE=true
# Signs the anti-forgery tokens of the server-rendered forms (openssl rand -hex 32).
TIPS_FORM_SECRET=

# ── OpenVibe.Billing (money moves only there) ───────────────
BILLING_URL=http://127.0.0.1:4600
#BILLING_AUDIENCE=openvibe.billing
# Checkout providers offered on tip pages (must be enabled on Billing).
TIPS_CHECKOUT_PROVIDERS=powerchat
# Billing's minimum purchase in bits; smaller tips can only be paid from a Vibes balance.
#TIPS_MIN_CHECKOUT_BITS=100
# Billing answers a PowerChat intent with a checkout_ref, not a URL. If set, Tips builds the link
# from it: {ref}, {cents} and {bits} are replaced. Without it the receipt says no link is available.
#TIPS_POWERCHAT_LINK_TEMPLATE=

# ── OpenVibe.Events ─────────────────────────────────────────
# Relay of Tips' outbox (tips.*); off when unset (rows wait in event_outbox).
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000
# Signing secret of Tips' subscription to billing.transaction.* (scripts/subscribe.js hands it to
# Events). Comma-separated during a rotation. Without it /internal/events answers 503.
TIPS_EVENTS_SECRET=

# ── Chat delivery ───────────────────────────────────────────
# live-chat (Live's /internal/tips/deliveries, docs/live-patch.diff) | test | none (production default)
#TIPS_CHAT_ADAPTER=none
#LIVE_INTERNAL_URL=http://127.0.0.1:3000
#LIVE_AUDIENCE=openvibe.live
#TIPS_DELIVERY_MAX_ATTEMPTS=6
#TIPS_DELIVERY_BACKOFF_MS=2000,10000,60000,300000,900000

# ── Overlays ────────────────────────────────────────────────
#TIPS_OVERLAY_TTL_MS=600000
#TIPS_OVERLAY_HEARTBEAT_MS=25000
#TIPS_OVERLAY_REPLAY_LIMIT=50

# ── Limits ──────────────────────────────────────────────────
#TIPS_MAX_BITS=10000000
#TIPS_MESSAGE_CHARS=300
#TIPS_TTS_HARD_CAP=1200
#TIPS_MEDIA_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be

# ── Background jobs: effects worker, due transfers, overlay window, outbox relay ──
#TIPS_JOBS=on
#TIPS_JOBS_INTERVAL_MS=2000
#LIVE_URL=https://openvibe.live
